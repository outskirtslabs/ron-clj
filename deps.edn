{:paths   ["src" "target/classes"]
 :deps    {org.clojure/clojure {:mvn/version "1.12.5"}}
 :aliases {:kaocha {:extra-paths ["test"]
                    :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                                  com.s-exp/oda       {:mvn/version "1.0.0-alpha41"}}
                    :main-opts   ["-m" "kaocha.runner"]}
           :dev    {:extra-paths ["dev"]
                    :jvm-opts    ["--add-modules=jdk.incubator.vector"]
                    :extra-deps  {dev.weavejester/hashp                    {:mvn/version "0.5.1"}
                                  io.github.tonsky/clj-reload              {:mvn/version "1.0.0"}
                                  djblue/portal                            {:mvn/version "0.67.2"}
                                  lambdaisland/ansi                        {:mvn/version "0.2.37"}
                                  my/dev-repl                              {:git/url "https://github.com/Ramblurr/clojure-dev-repl.git"
                                                                            :git/sha "f053984effdc6c78b1d1ce8a8878b00639854db8"}
                                  com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.8.0"}}}
           :build  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                                 slipset/deps-deploy           {:mvn/version "0.2.5"}}
                    :ns-default build}
           :jmh    {:extra-paths ["bench" "target/jmh-classes"]
                    :extra-deps  {jmh-clojure/jmh-clojure {:mvn/version "0.4.1"}}
                    :main-opts   ["-m" "ol.ron.jmh"]}
           :neil   {:project {:name        com.outskirtslabs/ron-clj
                              :url         "https://github.com/outskirtslabs/ron-clj"
                              :license     {:id "MIT"}
                              :description "Fast RON (Readable Object Notation) reader and writer for Clojure"
                              :platforms   [:clj]
                              :created     "2026-06-12"
                              :status      :experimental
                              :version     "0.0.1"}}}}
